# The container's settings: copy to docker/scanner.env (gitignored). docker-compose.yaml passes this
# file, and only this file, into the container. The stack's own settings and its secrets (the basic-auth
# password, the ticket token) stay in ../.env, which only scripts/deploy-stack.sh reads.

# The scanner: a tastytrade OAuth client with the read scope, and an FMP key.
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
FMP_API_KEY=

# The publisher: the bucket, and the key from the stack's PublishKeySecret
# (aws secretsmanager get-secret-value --secret-id spread-scanner/<bucket>/publisher).
S3_BUCKET=spread-scanner-yourname
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a healthchecks.io-style URL, pinged after each scheduled run (<url>/fail on failure).
# HEALTHCHECK_URL=
