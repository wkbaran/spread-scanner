# Copy to .env (gitignored). The stack's settings, read by scripts/deploy-stack.sh only. The container's
# settings (tastytrade, FMP, the publish key) are in docker/scanner.env (template:
# docker/scanner.env.example), so the container never holds the secrets below. Outside the container the
# scanner's credentials can live in ~/.config/spread-scanner/credentials.env.

S3_BUCKET=spread-scanner-yourname
AWS_REGION=us-east-1
STACK_NAME=spread-scanner-site
CUSTOM_DOMAIN=
HOSTED_ZONE_ID=
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# The Paper trade button (docker/README.md, "Paper trades"): the ticket queue for spread-book,
# and the token the page sends. 32+ random characters: openssl rand -hex 32
ENABLE_TICKETS=false
TICKET_TOKEN=
