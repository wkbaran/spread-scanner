# Copy to .env (gitignored). Read by the container (docker/docker-compose.yaml passes it in) and by
# scripts/deploy-stack.sh. Credentials can instead live in ~/.config/spread-scanner/credentials.env
# when you run the scanner outside the container.

# The scanner: a tastytrade OAuth client with the read scope, and an FMP key.
TT_CLIENT_SECRET=
TT_REFRESH_TOKEN=
FMP_API_KEY=

# The site: the stack's name and settings (scripts/deploy-stack.sh) ...
S3_BUCKET=spread-scanner-yourname
AWS_REGION=us-east-1
STACK_NAME=spread-scanner-site
CUSTOM_DOMAIN=
HOSTED_ZONE_ID=
ENABLE_BASIC_AUTH=false
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# The Paper trade button (docker/README.md, "Paper trades"): the ticket queue for spread-book,
# and the token the page sends. 32+ random characters: openssl rand -hex 32
ENABLE_TICKETS=false
TICKET_TOKEN=

# ... and the publisher's key, from the stack's outputs after the first deploy.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a healthchecks.io-style URL, pinged after each scheduled run (<url>/fail on failure).
# HEALTHCHECK_URL=
